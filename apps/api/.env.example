PORT=4000
MONGODB_URI=mongodb://localhost:27017/drone_delivery
JWT_SECRET=your-secret-key
# Required for restaurant and shipper bank-account profiles. Use a dedicated
# 32-byte random key encoded as base64 or 64 hexadecimal characters; never reuse JWT_SECRET.
BANK_ACCOUNT_ENCRYPTION_KEY=replace_with_a_32_byte_base64_key

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

FRONTEND_URL=http://localhost:5173
# Shared browser page used by account-security email links. Keep this server
# controlled; never accept a reset/login destination from a client request.
ACCOUNT_SECURITY_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Optional
TRACKASIA_KEY=public_key
NODE_ENV=development
# Logging level: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# For password reset emails (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email
SMTP_PASS=your-app-password
SMTP_FROM="Drone Food <your-email>"
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
# Graceful shutdown is never shorter than all SMTP timeouts plus a DB margin.
SERVER_SHUTDOWN_TIMEOUT_MS=45000
# Durable account-email jobs are retried by the API process.
ACCOUNT_EMAIL_WORKER_INTERVAL_MS=5000
# Pending reset jobs are reconciled only after this request activation grace.
ACCOUNT_EMAIL_PENDING_RESET_GRACE_MS=30000
# Unmatched pending reset jobs retry at this cadence until their token expires.
ACCOUNT_EMAIL_PENDING_RESET_RETRY_MS=30000
# Equalizes public forgot-password response timing for known/unknown emails.
FORGOT_PASSWORD_MIN_RESPONSE_MS=350

# For VNPAY Payment
VNPAY_TMN_CODE=your-vnpay-terminal-code
VNPAY_HASH_SECRET=your-vnpay-hash-secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Public backend URLs — VNPay must be able to reach them.
VNPAY_RETURN_URL=https://your-ngrok-domain.ngrok-free.dev/api/order/vnpay-return
VNPAY_DEPOSIT_RETURN_URL=https://your-ngrok-domain.ngrok-free.dev/api/wallet/vnpay/deposit-return
