# Local Android physical device: http://<LAN-IP>:4000
# Production: https://<your-render-service>.onrender.com
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
# Required by Expo Push Notifications in development/release builds.
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id
# Reserved for the next mobile Turnstile WebView task. These values are public; do not put TURNSTILE_SECRET_KEY in Expo.
# Backend production enforcement is already enabled, so mobile auth requires this follow-up before release.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=replace_with_cloudflare_turnstile_site_key
EXPO_PUBLIC_TURNSTILE_BRIDGE_URL=https://api.dronefood.io.vn/turnstile-bridge
