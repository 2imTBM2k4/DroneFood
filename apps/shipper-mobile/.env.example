# Local Android physical device: http://<LAN-IP>:4000
# Production: https://<your-render-service>.onrender.com
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
# Required by Expo Push Notifications in development/release builds.
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id
# Development-only fallback for an Android Emulator that cannot emit GPS.
# Format: latitude,longitude. Omit this variable on real devices and production.
EXPO_PUBLIC_SHIPPER_TEST_LOCATION=10.7769,106.7008
# Development-only animated route. Separate locations with semicolons.
EXPO_PUBLIC_SHIPPER_TEST_ROUTE=10.7769,106.7008;10.7773,106.7012;10.7777,106.7017;10.7781,106.7021
